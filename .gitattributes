# Normaliza o fim de linha no repositório, para que a equipe não produza diffs
# de arquivo inteiro ao trabalhar em sistemas diferentes.
* text=auto eol=lf

*.sql       text eol=lf
*.java      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.xml       text eol=lf

mvnw        text eol=lf
mvnw.cmd    text eol=crlf

*.jar       binary
*.png       binary
*.jpg       binary
*.pdf       binary
